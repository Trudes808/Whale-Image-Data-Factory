# Text files: normalize line endings (Unreal ini/uproject/python edited on Linux).
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.ini text eol=lf
*.uproject text eol=lf

# Unreal binary assets -> Git LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

